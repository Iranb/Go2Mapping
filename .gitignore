# outputs contains application source as well as private runtime data.
# Allow only the reviewed web sources and the procedural replay.
/outputs/*
!/outputs/go2-live-demo/
/outputs/go2-live-demo/*
!/outputs/go2-live-demo/index.html
!/outputs/go2-live-demo/assets/
!/outputs/go2-live-demo/vendor/
/outputs/go2-live-demo/assets/*
